{
  "name": "manto-sagrado",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "apphosting:build": "node apphosting-build.mjs",
    "build": "node apphosting-build.mjs",
    "start": "node server.mjs",
    "dev": "turbo dev",
    "dev:storefront": "pnpm --filter @manto-sagrado/storefront dev",
    "dev:admin": "pnpm --filter @manto-sagrado/admin dev",
    "dev:api": "pnpm --filter @manto-sagrado/api dev",
    "build:all": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @manto-sagrado/api prisma:generate",
    "db:migrate": "pnpm --filter @manto-sagrado/api prisma:migrate",
    "db:seed": "pnpm --filter @manto-sagrado/api prisma:seed"
  },
  "dependencies": {},
  "devDependencies": {
    "turbo": "2.10.6",
    "typescript": "6.0.3"
  }
}
